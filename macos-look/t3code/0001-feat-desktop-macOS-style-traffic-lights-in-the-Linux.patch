--- a/apps/desktop/src/ipc/methods/window.ts
+++ b/apps/desktop/src/ipc/methods/window.ts
@@ -503,6 +503,22 @@ export const revealWindow = DesktopIpc.makeIpcMethod({
   }),
 });
 
+export const windowControl = DesktopIpc.makeIpcMethod({
+  channel: IpcChannels.WINDOW_CONTROL_CHANNEL,
+  payload: Schema.Literals(["minimize", "toggle-maximize", "close"]),
+  result: Schema.Void,
+  handler: (action, event) =>
+    Effect.sync(() => {
+      const sender = event && Electron.webContents.fromId(event.sender.id);
+      const window = sender && Electron.BrowserWindow.fromWebContents(sender);
+      if (!window || window.isDestroyed()) return;
+      if (action === "minimize") window.minimize();
+      else if (action === "close") window.close();
+      else if (window.isMaximized()) window.unmaximize();
+      else window.maximize();
+    }).pipe(Effect.withSpan("desktop.ipc.window.windowControl")),
+});
+
 const htmlFullscreenStates = new WeakMap<
   Electron.BrowserWindow,
   { owned: boolean; leaving: boolean }
