diff --git a/apps/web/src/components/LinuxWindowControls.tsx b/apps/web/src/components/LinuxWindowControls.tsx
new file mode 100644
index 0000000000..b1681cbeda
--- /dev/null
+++ b/apps/web/src/components/LinuxWindowControls.tsx
@@ -0,0 +1,72 @@
+import { useSyncExternalStore } from "react";
+
+import { cn } from "../lib/utils";
+
+const BUTTONS = [
+  {
+    action: "close",
+    label: "Close window",
+    color: "bg-[#ff5f57]",
+    hoverColor: "group-hover:bg-[#ff5f57]",
+    glyph: "M3.5 3.5l5 5M8.5 3.5l-5 5",
+  },
+  {
+    action: "minimize",
+    label: "Minimize window",
+    color: "bg-[#febc2e]",
+    hoverColor: "group-hover:bg-[#febc2e]",
+    glyph: "M2.5 6h7",
+  },
+  {
+    action: "toggle-maximize",
+    label: "Maximize window",
+    color: "bg-[#28c840]",
+    hoverColor: "group-hover:bg-[#28c840]",
+    glyph: "M6 2.5v7M2.5 6h7",
+  },
+] as const;
+
+function subscribeToWindowFocus(onChange: () => void): () => void {
+  window.addEventListener("focus", onChange);
+  window.addEventListener("blur", onChange);
+  return () => {
+    window.removeEventListener("focus", onChange);
+    window.removeEventListener("blur", onChange);
+  };
+}
+
+function readWindowFocus(): boolean {
+  return document.hasFocus();
+}
+
+export function LinuxWindowControls() {
+  const focused = useSyncExternalStore(subscribeToWindowFocus, readWindowFocus);
+  return (
+    <div className="group fixed top-[var(--workspace-controls-top)] left-4 z-50 flex h-[var(--workspace-topbar-height)] items-center gap-2 [-webkit-app-region:no-drag]">
+      {BUTTONS.map((button) => (
+        <button
+          key={button.action}
+          type="button"
+          aria-label={button.label}
+          className={cn(
+            "flex size-3 items-center justify-center rounded-full",
+            focused ? button.color : cn("bg-muted-foreground/40", button.hoverColor),
+          )}
+          onClick={() => void window.desktopBridge?.windowControl?.(button.action)}
+        >
+          <svg
+            viewBox="0 0 12 12"
+            // oxlint-disable-next-line shadcn/no-arbitrary-values -- traffic-light glyphs stay dark in both themes, as on macOS
+            className="size-3 text-[#0000008c] opacity-0 group-hover:opacity-100"
+            fill="none"
+            stroke="currentColor"
+            strokeWidth={1.3}
+            strokeLinecap="round"
+          >
+            <path d={button.glyph} />
+          </svg>
+        </button>
+      ))}
+    </div>
+  );
+}
